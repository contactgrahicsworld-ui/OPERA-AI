# OPERA AI — Environment variables (production)
# Copy to .env.production and fill in real values. NEVER commit .env.production to git.

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Auth
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
SESSION_SECRET="generate-with-openssl-rand-base64-32"

# Public
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# AI (optional - uses local fallback if not set)
ZAI_API_KEY=""

# Storage (for recordings/documents - Supabase Storage)
SUPABASE_STORAGE_BUCKET="opera-ai-storage"

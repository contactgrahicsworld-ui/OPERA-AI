// OPERA AI — Production PostgreSQL schema (Supabase)
// Uses native jsonb + array types where appropriate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // for migrations
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  status      String   @default("active")
  planId      String?
  trialEndsAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan Plan? @relation(fields: [planId], references: [id])
  
  users User[]
  businessProfile BusinessProfile?
  businessDNA BusinessDNA?
  pipelines Pipeline[]
  leads Lead[]
  contacts Contact[]
  customers Customer[]
  companies Company[]
  deals Deal[]
  activities Activity[]
  calls Call[]
  callRequests CallRequest[]
  callEvents CallEvent[]
  meetings Meeting[]
  tasks Task[]
  followUps FollowUp[]
  notes Note[]
  documents Document[]
  quotations Quotation[]
  orders Order[]
  payments Payment[]
  invoices Invoice[]
  expenses Expense[]
  employees Employee[]
  departments Department[]
  attendance Attendance[]
  leaves Leave[]
  products Product[]
  warehouses Warehouse[]
  stockItems StockItem[]
  stockMovements StockMovement[]
  suppliers Supplier[]
  purchaseOrders PurchaseOrder[]
  campaigns Campaign[]
  leadSources LeadSource[]
  automations Automation[]
  automationRuns AutomationRun[]
  aiInsights AIInsight[]
  aiActions AIAction[]
  aiExecutions AIExecution[]
  customFields CustomField[]
  customFieldValues CustomFieldValue[]
  auditLogs AuditLog[]
  notifications Notification[]
  subscriptions Subscription[]
  aiUsageRecords AIUsageRecord[]
  workflowRuns WorkflowRun[]
  tags Tag[]
  devices Device[]
  recordings Recording[]
  transcripts Transcript[]
  subscriptionPayments SubscriptionPayment[]
  subscriptionInvoices SubscriptionInvoice[]
}

model Plan {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String
  priceMonthly  Int      @default(0)
  priceYearly   Int      @default(0)
  trialDays     Int      @default(7)
  maxUsers      Int      @default(5)
  maxStorageMb  Int      @default(1024)
  maxAiCalls    Int      @default(100)
  featuresCsv   String   @default("")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenants Tenant[]
  subscriptions Subscription[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  role          String   @default("OWNER")
  isSuperAdmin  Boolean  @default(false)
  tenantId      String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant Tenant? @relation(fields: [tenantId], references: [id])
  leadsAssigned Lead[]
  tasksAssigned Task[]   @relation("TaskAssignee")
  tasksOwned    Task[]   @relation("TaskOwner")
  calls         Call[]
  @@index([tenantId])
  @@index([role])
}

model BusinessProfile {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  businessName    String
  businessType    String   @default("")
  industry        String   @default("")
  productsCsv     String   @default("")
  servicesCsv     String   @default("")
  customerTypes   String   @default("")
  salesProcess    String   @default("")
  leadSources     String   @default("")
  teamStructure   String   @default("")
  departments     String   @default("")
  locations       String   @default("")
  businessHours   String   @default("")
  currency        String   @default("INR")
  taxSettings     Json     @default("{}")
  usesInventory   Boolean  @default(false)
  paymentProcess  String   @default("")
  followUpProcess String   @default("")
  customWorkflow  String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant Tenant   @relation(fields: [tenantId], references: [id])
}

model BusinessDNA {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  industry           String
  businessModel      String
  productsServices   Json     @default("[]")
  customerSegments   Json     @default("[]")
  salesStages        Json     @default("[]")
  operationalStages  Json     @default("[]")
  departments        Json     @default("[]")
  roles              Json     @default("[]")
  kpis               Json     @default("[]")
  workflowDefs       Json     @default("[]")
  automationOpps     Json     @default("[]")
  aiPriorities       Json     @default("[]")
  customFields       Json     @default("[]")
  terminology        Json     @default("[]")
  generatedBy        String   @default("ai")
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant Tenant      @relation(fields: [tenantId], references: [id])
}

model Pipeline {
  id String @id @default(cuid())
  tenantId String
  name String
  entity String @default("lead")
  stages String[] @default(["New","Contacted","Qualified","Won","Lost"])
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  leads Lead[]
  deals Deal[]
  @@unique([tenantId, name, entity])
  @@index([tenantId])
}

model Lead {
  id String @id @default(cuid())
  tenantId String
  name String
  email String @default("")
  phone String @default("")
  company String @default("")
  source String @default("manual")
  status String @default("New")
  pipelineId String?
  stage String @default("New")
  ownerId String?
  value Int @default(0)
  priority String @default("medium")
  tags String[] @default([])
  notes String @default("")
  lastActivityAt DateTime?
  convertedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  owner User? @relation(fields: [ownerId], references: [id])
  pipeline Pipeline? @relation(fields: [pipelineId], references: [id])
  activities Activity[]
  calls Call[]
  callRequests CallRequest[]
  meetings Meeting[]
  followUps FollowUp[]
  tasks Task[]
  notesRel Note[]
  quotations Quotation[]
  @@unique([tenantId, email, phone])
  @@index([tenantId, status])
  @@index([tenantId, ownerId])
}

model Contact {
  id String @id @default(cuid())
  tenantId String
  name String
  email String @default("")
  phone String @default("")
  companyId String?
  position String @default("")
  isPrimary Boolean @default(false)
  tags String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])
  @@unique([tenantId, email])
  @@index([tenantId])
}

model Company {
  id String @id @default(cuid())
  tenantId String
  name String
  website String @default("")
  industry String @default("")
  email String @default("")
  phone String @default("")
  address String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  contacts Contact[]
  @@unique([tenantId, name])
  @@index([tenantId])
}

model Customer {
  id String @id @default(cuid())
  tenantId String
  name String
  email String @default("")
  phone String @default("")
  company String @default("")
  type String @default("individual")
  status String @default("active")
  totalValue Int @default(0)
  lastOrderAt DateTime?
  tags String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  orders Order[]
  invoices Invoice[]
  payments Payment[]
  @@unique([tenantId, email, phone])
  @@index([tenantId, status])
}

model Deal {
  id String @id @default(cuid())
  tenantId String
  title String
  customerId String?
  contactId String?
  value Int @default(0)
  stage String @default("New")
  pipelineId String?
  ownerId String?
  expectedCloseDate DateTime?
  probability Int @default(0)
  closedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  pipeline Pipeline? @relation(fields: [pipelineId], references: [id])
  @@index([tenantId])
}

model Activity {
  id String @id @default(cuid())
  tenantId String
  type String
  title String
  description String @default("")
  leadId String?
  customerId String?
  ownerId String?
  outcome String @default("")
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  lead Lead? @relation(fields: [leadId], references: [id])
  @@index([tenantId, type])
  @@index([leadId])
}

// SIM-BASED CALLING ARCHITECTURE
model CallRequest {
  id String @id @default(cuid())
  tenantId String
  leadId String?
  customerId String?
  contactId String?
  callerId String
  phoneNumber String
  deviceId String?
  state String @default("QUEUED") // QUEUED | SENT | RECEIVED | DIALING | RINGING | CONNECTED | ENDED | FAILED | CANCELLED
  idempotencyKey String @unique
  eventId String? @unique
  priority Int @default(5)
  notes String @default("")
  queuedAt DateTime @default(now())
  sentAt DateTime?
  receivedAt DateTime?
  startedAt DateTime?
  endedAt DateTime?
  duration Int @default(0)
  outcome String @default("")
  failureReason String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  lead Lead? @relation(fields: [leadId], references: [id])
  events CallEvent[]
  call Call?
  @@index([tenantId, state])
  @@index([deviceId])
}

model CallEvent {
  id String @id @default(cuid())
  tenantId String
  callRequestId String
  eventId String @unique // idempotency
  eventType String // QUEUED | SENT | DIALING | RINGING | CONNECTED | ENDED | FAILED
  payload Json @default("{}")
  receivedAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id])
  callRequest CallRequest @relation(fields: [callRequestId], references: [id])
  @@index([callRequestId])
  @@index([eventType])
}

model Call {
  id String @id @default(cuid())
  tenantId String
  leadId String?
  customerId String?
  contactId String?
  callerId String
  callRequestId String? @unique
  direction String @default("outbound")
  status String @default("planned")
  outcome String @default("")
  duration Int @default(0)
  notes String @default("")
  nextFollowUpAt DateTime?
  telecaller String @default("human") // human | ai
  recordingId String?
  transcriptId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  lead Lead? @relation(fields: [leadId], references: [id])
  caller User @relation(fields: [callerId], references: [id])
  callRequest CallRequest? @relation(fields: [callRequestId], references: [id])
  @@index([tenantId])
  @@index([leadId])
}

model Recording {
  id String @id @default(cuid())
  tenantId String
  callId String?
  state String @default("RECORDING_NOT_SUPPORTED") // RECORDING_AVAILABLE | RECORDING_ACTIVE | RECORDING_SAVED | RECORDING_NOT_SUPPORTED | RECORDING_PERMISSION_REQUIRED | RECORDING_FAILED
  fileUrl String?
  fileSizeBytes Int?
  mimeType String @default("audio/m4a")
  durationSeconds Int @default(0)
  checksum String?
  encrypted Boolean @default(true)
  retentionDays Int @default(90)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  @@index([callId])
}

model Transcript {
  id String @id @default(cuid())
  tenantId String
  callId String?
  recordingId String?
  language String @default("en-IN")
  segments Json @default("[]") // [{start, end, text, speaker}]
  fullText String @default("")
  aiSummary String @default("")
  generatedBy String @default("rules") // rules | ai
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
}

model Meeting {
  id String @id @default(cuid())
  tenantId String
  title String
  leadId String?
  customerId String?
  attendeeIds String[] @default([])
  location String @default("")
  scheduledAt DateTime
  endedAt DateTime?
  notes String @default("")
  outcome String @default("")
  ownerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  lead Lead? @relation(fields: [leadId], references: [id])
  @@index([tenantId, scheduledAt])
}

model Task {
  id String @id @default(cuid())
  tenantId String
  title String
  description String @default("")
  type String @default("general")
  status String @default("open")
  priority String @default("medium")
  dueDate DateTime?
  leadId String?
  customerId String?
  assigneeId String?
  ownerId String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  lead Lead? @relation(fields: [leadId], references: [id])
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  owner User? @relation("TaskOwner", fields: [ownerId], references: [id])
  @@index([tenantId, status])
  @@index([assigneeId])
  @@index([dueDate])
}

model FollowUp {
  id String @id @default(cuid())
  tenantId String
  leadId String?
  customerId String?
  title String
  dueAt DateTime
  completedAt DateTime?
  ownerId String?
  outcome String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  lead Lead? @relation(fields: [leadId], references: [id])
  @@index([tenantId, dueAt])
}

model Note {
  id String @id @default(cuid())
  tenantId String
  leadId String?
  customerId String?
  content String
  ownerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  lead Lead? @relation(fields: [leadId], references: [id])
  @@index([tenantId])
}

model Document {
  id String @id @default(cuid())
  tenantId String
  name String
  type String @default("file")
  url String
  size Int @default(0)
  mime String @default("")
  leadId String?
  customerId String?
  ownerId String?
  isPrivate Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
}

model Quotation {
  id String @id @default(cuid())
  tenantId String
  number String
  leadId String?
  customerId String?
  subject String
  status String @default("draft")
  totalAmount Int @default(0)
  discount Int @default(0)
  taxAmount Int @default(0)
  currency String @default("INR")
  validTill DateTime?
  sentAt DateTime?
  approvedAt DateTime?
  ownerId String?
  items Json @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  lead Lead? @relation(fields: [leadId], references: [id])
  orders Order[]
  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model Order {
  id String @id @default(cuid())
  tenantId String
  number String
  quotationId String?
  customerId String
  status String @default("pending")
  totalAmount Int @default(0)
  currency String @default("INR")
  items Json @default("[]")
  ownerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])
  payments Payment[]
  invoices Invoice[]
  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model Payment {
  id String @id @default(cuid())
  tenantId String
  number String
  customerId String?
  orderId String?
  invoiceId String?
  amount Int
  currency String @default("INR")
  method String @default("cash")
  status String @default("received")
  paidAt DateTime
  notes String @default("")
  idempotencyKey String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([customerId])
}

model Invoice {
  id String @id @default(cuid())
  tenantId String
  number String
  customerId String
  orderId String?
  amount Int
  taxAmount Int @default(0)
  totalAmount Int
  currency String @default("INR")
  status String @default("unpaid")
  dueDate DateTime?
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])
  payments Payment[]
  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model Expense {
  id String @id @default(cuid())
  tenantId String
  category String @default("general")
  description String
  amount Int
  currency String @default("INR")
  paidBy String?
  paidAt DateTime
  receiptUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId, category])
}

model Department {
  id String @id @default(cuid())
  tenantId String
  name String
  headId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  employees Employee[]
  @@unique([tenantId, name])
}

model Employee {
  id String @id @default(cuid())
  tenantId String
  userId String?
  name String
  email String @default("")
  phone String @default("")
  position String @default("")
  departmentId String?
  type String @default("full_time")
  status String @default("active")
  joinedAt DateTime?
  salary Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  attendances Attendance[]
  leaves Leave[]
  @@unique([tenantId, email])
  @@index([tenantId])
}

model Attendance {
  id String @id @default(cuid())
  tenantId String
  employeeId String
  date DateTime
  checkIn DateTime?
  checkOut DateTime?
  status String @default("present")
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  @@unique([tenantId, employeeId, date])
}

model Leave {
  id String @id @default(cuid())
  tenantId String
  employeeId String
  type String @default("casual")
  startDate DateTime
  endDate DateTime
  status String @default("pending")
  reason String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  @@index([tenantId, status])
}

model Product {
  id String @id @default(cuid())
  tenantId String
  name String
  sku String @default("")
  type String @default("product")
  category String @default("")
  description String @default("")
  price Int @default(0)
  cost Int @default(0)
  unit String @default("unit")
  taxRate Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  stockItems StockItem[]
  movements StockMovement[]
  @@unique([tenantId, sku])
  @@index([tenantId])
}

model Warehouse {
  id String @id @default(cuid())
  tenantId String
  name String
  location String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  stockItems StockItem[]
  @@unique([tenantId, name])
}

model StockItem {
  id String @id @default(cuid())
  tenantId String
  productId String
  warehouseId String?
  quantity Int @default(0)
  reorderLevel Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  @@unique([tenantId, productId, warehouseId])
}

model StockMovement {
  id String @id @default(cuid())
  tenantId String
  productId String
  type String
  quantity Int
  fromWarehouseId String?
  toWarehouseId String?
  refType String @default("")
  refId String?
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  @@index([tenantId, productId])
}

model Supplier {
  id String @id @default(cuid())
  tenantId String
  name String
  email String @default("")
  phone String @default("")
  address String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]
  @@unique([tenantId, name])
}

model PurchaseOrder {
  id String @id @default(cuid())
  tenantId String
  number String
  supplierId String
  status String @default("draft")
  totalAmount Int @default(0)
  items Json @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  @@unique([tenantId, number])
}

model Campaign {
  id String @id @default(cuid())
  tenantId String
  name String
  channel String @default("manual")
  status String @default("planned")
  budget Int @default(0)
  spent Int @default(0)
  leadsCount Int @default(0)
  conversions Int @default(0)
  startDate DateTime?
  endDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, name])
}

model LeadSource {
  id String @id @default(cuid())
  tenantId String
  name String
  type String @default("manual")
  leadsCount Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, name])
}

model AIInsight {
  id String @id @default(cuid())
  tenantId String
  title String
  type String
  priority String @default("medium")
  evidence Json @default("[]")
  sourceRefs Json @default("[]")
  recommendedAction String
  confidence Int @default(50)
  uncertainty String @default("")
  category String @default("general")
  status String @default("active")
  generatedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  actions AIAction[]
  @@index([tenantId, status])
  @@index([tenantId, priority])
}

model AIAction {
  id String @id @default(cuid())
  tenantId String
  insightId String?
  title String
  description String @default("")
  category String @default("general")
